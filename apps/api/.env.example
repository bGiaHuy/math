# ==============================================================================
# AdaptiveMath API — Environment Variables Template
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
# Additional trusted browser origins, comma-separated. Use exact HTTPS domains in production.
WEB_ALLOWED_ORIGINS=

# Database Configuration (PostgreSQL running via am-postgres)
POSTGRES_USER=am
POSTGRES_PASSWORD=am_dev_password
POSTGRES_DB=adaptivemath
POSTGRES_PORT=5432
DATABASE_URL="postgresql://am:am_dev_password@localhost:5432/adaptivemath?schema=public"

# Redis Configuration (running via am-redis)
REDIS_URL="redis://localhost:6379"

# Session & Security
# Session Secret for HMAC signature (Minimum 32 random characters)
SESSION_SECRET=adaptivemath_dev_session_secret_key_at_least_32_chars_long
# Development uses am_session. Production must use __Host-am_session with HTTPS.
SESSION_COOKIE_NAME=am_session
SESSION_TTL_SECONDS=604800 # 7 days

# Argon2id Parameters for Password Hashing
ARGON_MEMORY_COST=65536
ARGON_TIME_COST=3
ARGON_PARALLELISM=4

# Invitation Code Crockford HMAC Secret
INVITE_CODE_HMAC_SECRET=adaptivemath_dev_invite_code_hmac_secret_key_32_chars

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
AUTH_RATE_LIMIT_LIMIT=5
# AI: BACKEND ONLY. Never prefix this key with VITE_ or put it in browser settings.
AI_ENABLED=false
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# For MWAPI: AI_PROVIDER=mwapi; use AUTH_TOKEN instead of API_KEY.
ANTHROPIC_AUTH_TOKEN=
# Project-specific override avoids inheriting a coding agent's own token.
MATH_MWAPI_AUTH_TOKEN=
# Required before enabling MWAPI. Enter effective USD prices from your MWAPI plan.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
AI_MODEL=claude-haiku-4-5-20251001
# Supported alternative: claude-sonnet-4-6 (higher cost).
# Lifetime cap does not reset monthly, protecting a prepaid $100 account.
AI_LIFETIME_BUDGET_USD=90
AI_MONTHLY_BUDGET_USD=30
AI_DAILY_BUDGET_USD=5
AI_USER_DAILY_BUDGET_USD=0.15
AI_USER_DAILY_REQUESTS=40
AI_USER_REQUESTS_PER_MINUTE=6
AI_IP_REQUESTS_PER_MINUTE=30
AI_MAX_CONCURRENT_REQUESTS=4
