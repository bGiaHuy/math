{
  "name": "adaptivemath-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:prototype": "vite",
    "dev:api": "npm run start --workspace=@adaptivemath/api",
    "build": "vite build",
    "build:prototype": "vite build",
    "build:api": "npm run build --workspace=@adaptivemath/api",
    "typecheck": "npm run typecheck --workspace=@adaptivemath/api",
    "test": "npm run test --workspace=@adaptivemath/api",
    "prisma:generate": "npm run prisma:generate --workspace=@adaptivemath/api",
    "prisma:push": "npm run prisma:push --workspace=@adaptivemath/api",
    "prisma:seed": "npm run prisma:seed --workspace=@adaptivemath/api",
    "content:import": "npm run content:import --workspace=@adaptivemath/api",
    "e2e:browser": "node scripts/run-browser-e2e.mjs",
    "package:release": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "katex": "^0.16.11",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "^4.13.0",
    "puppeteer-core": "^25.11.0",
    "vite": "8.3.0"
  }
}
